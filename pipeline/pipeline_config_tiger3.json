{
  "run_name": "tiger_1--p0.85",
  "output_root": "runs",
  "train": {
    "enabled": true,
    "name": "tiger_agent_p_0.85",
    "args": [
      "--eval-period", "5",
      "--num-rollouts", "50",
      "--num-episodes", "1601",
      "--batch-size", "32",
      "--learning-rate", "0.001",
      "--num-gradient-steps", "10",
      "--target-period", "10",
      "--epsilon", "0.2",
      "--buffer-capacity", "8192",
      "tiger",
      "--listen-accuracy", "0.85"
    ]
  },
  "decoder_train": {
    "enabled": true,
    "name": "frozen_decoders",
    "args": [
      "--run_regression",
      "--run_softmax_belief",
      "--period", "250",
      "--end_episode", "1600",
      "--probe_num_samples", "10000",
      "--probe_valid_size", "0.2",
      "--probe_epochs", "300",
      "--probe_lr", "0.001",
      "--probe_batch_size", "1024",
      "--sm_use_mlp",
      "--belief_loss", "kl"
    ]
  },
  "protocol_a": {
    "enabled": true,
    "name": "protocolA",
    "args": [
      "--run_softmax_linear_probe",
      "--run_softmax_mlp_probe",
      "--period", "400",
      "--end_episode", "1600",
      "--probe_num_samples", "10000",
      "--probe_valid_size", "0.2",
      "--probe_epochs", "300",
      "--probe_lr", "0.001",
      "--probe_batch_size", "1024",
      "--mine_num_samples", "10000",
      "--mine_num_epochs", "400",
      "--mine_batch_size", "1024",
      "--mine_learning_rate", "0.001"
    ],
    "tests": [
      {
        "label": "listen_accuracy",
        "flag": "--test_listen_accuracy"
      },
      {
        "label": "reward_listen",
        "flag": "--test_reward_listen"
      }
    ]
  },
  "protocol_b": {
    "enabled": true,
    "name": "protocolB",
    "args": [
      "--run_softmax_linear_probe",
      "--run_softmax_mlp_probe",
      "--num_samples", "10000",
      "--period", "400",
      "--end_episode", "1600",
      "--belief_total_steps", "4000",
      "--valid_size", "0.2",
      "--probe_epochs", "300",
      "--probe_lr", "0.001",
      "--probe_batch_size", "1024",
      "--mine_num_epochs", "400",
      "--mine_batch_size", "1024",
      "--mine_learning_rate", "0.001"
    ],
    "tests": [
      {
        "label": "listen_accuracy",
        "flag": "--test_listen_accuracy"
      },
      {
        "label": "reward_listen",
        "flag": "--test_reward_listen"
      }
    ]
  }
